# Copy this file to a new file called .env and fill in your own values.
# .env is listed in .gitignore, so it never gets committed.
# Never paste these values into a chat or a screenshot.

# Splunk admin password. At least 8 characters.
SPLUNK_PASSWORD=

# Token that WEB01 uses to send the WAF and Linux logs to Splunk (HEC).
# Make one in PowerShell with:  [guid]::NewGuid()
SPLUNK_HEC_TOKEN=
